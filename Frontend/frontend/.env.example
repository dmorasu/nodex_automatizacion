# URL del backend (server actions / SSR)
API_URL=http://localhost:4000/api

# URL del backend expuesta al navegador
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Dirección de Nodex Gastos (para el enlace "Ver en Nodex Gastos" de la pestaña Gastos). Opcional
GASTOS_URL=http://localhost:3001

# Mapa de Google en Rutas de mensajeros (Maps JavaScript API). Clave para el NAVEGADOR,
# restringida por dominio (HTTP referrer). Sin ella, el mapa usa OpenStreetMap. Opcional
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID de Google Cloud (marcadores avanzados). Si se deja vacío se usa DEMO_MAP_ID. Opcional
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
