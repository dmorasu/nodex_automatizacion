# Monitor de Nodex · copiar a Monitor/.env (chmod 600, dueño nodexmon) y llenar
# Instalación completa: deploy/monitor/INSTALACION.md

# Panel (solo escucha en 127.0.0.1; al público llega por Nginx en monitor.nodexgpa.com)
MONITOR_PUERTO=9010
MONITOR_USUARIO=
# Se genera con: node src/clave.js   (pide la contraseña y entrega el valor)
MONITOR_CLAVE_HASH=
MONITOR_DIR_DATOS=/var/lib/nodex-monitor

# Avisos: correo para todo, WhatsApp solo para lo urgente
MONITOR_NOTIFICAR=si
MONITOR_CORREOS=
# Números con indicativo, separados por coma: +573001234567
MONITOR_WHATSAPP=
SENDGRID_API_KEY=
EMAIL_FROM=
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Plantilla aprobada en Twilio con una variable {{1}} (ContentSid HX...). Sin ella el WhatsApp
# solo llega si escribiste al número de Twilio en las últimas 24 horas (regla de WhatsApp).
MONITOR_TWILIO_PLANTILLA=

# Qué se vigila
MONITOR_SITIOS=https://tramites.nodexgpa.com,https://gastos.nodexgpa.com,https://tramitadores.nodexgpa.com,https://api.nodexgpa.com
MONITOR_PUERTOS_PERMITIDOS=22,80,443
# IPs (o inicios de IP, ej. 190.85.) desde las que es normal entrar por SSH
MONITOR_IPS_CONOCIDAS=
MONITOR_PROCESOS_IGNORAR=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
